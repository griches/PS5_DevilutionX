+#ifdef __PROSPERO__
+/**
+ * PS5 DevLoop's grab: when its request file can be removed, the frame being
+ * presented is written as a new PNG in a folder that holds nothing else.
+ */
+void Ps5GrabRequest()
+{
+	static unsigned calls;
+	static unsigned grabs;
+	if (++calls % 4 != 0 || unlink("/app0/devloop-shot") != 0)
+		return;
+	const char *partial = "/app0/userdata/grab.partial";
+	SDL_IOStream *stream = SDL_IOFromFile(partial, "wb");
+	if (stream == nullptr) {
+		LogError("PS5 grab: {}: {}", partial, SDL_GetError());
+		return;
+	}
+	const auto written = WriteSurfaceToFilePng(GlobalBackBuffer(), stream);
+	if (!written.has_value()) {
+		LogError("PS5 grab: no picture written: {}", written.error());
+		return;
+	}
+	char name[64];
+	std::snprintf(name, sizeof(name), "/app0/userdata/screenshots/grab-%04u.png", grabs++);
+	std::rename(partial, name);
+}
+#endif
+
 void RenderPresent()
 {
 	if (HeadlessMode)
 		return;
 
+#ifdef __PROSPERO__
+	Ps5GrabRequest();
+#endif
+
 	SDL_Surface *surface = GetOutputSurface();
 
 	if (!gbActive) {
